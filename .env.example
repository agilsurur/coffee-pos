APP_PORT=8080
APP_ENV=development

# Docker Compose (MySQL container)
MYSQL_ROOT_PASSWORD=secret
MYSQL_DATABASE=coffee_pos

# Aplikasi Go: DB_PASSWORD harus sama dengan MYSQL_ROOT_PASSWORD selama DB_USER=root
DB_HOST=localhost
DB_PORT=3306
DB_NAME=coffee_pos
DB_USER=root
DB_PASSWORD=secret
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_SECRET=your-secret-key-minimum-32-characters
JWT_EXPIRY_HOURS=24
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_ENV=sandbox
